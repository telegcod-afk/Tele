# ==============================
# Telegram
# ==============================
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
BOT_USERNAME=your_bot_username
STORAGE_CHANNEL_ID=-1001234567890

# ==============================
# Database / Supabase PostgreSQL
# ==============================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ==============================
# Public URL (Railway)
# ==============================
PUBLIC_BASE_URL=https://your-app.up.railway.app

# ==============================
# Force Subscribe — exactly 2 channels
# ==============================
FORCE_CHANNEL_1=-1001234567890
FORCE_CHANNEL_2=-1009876543210

# ==============================
# BayarGG — QR Otomatis 2
# ==============================
BAYARGG_API_KEY=
BAYARGG_MERCHANT=
BAYARGG_WEBHOOK_SECRET=

# ==============================
# Cashi.id — QR Otomatis 1
# ==============================
CASHI_API_KEY=
CASHI_SECRET_KEY=
CASHI_BASE_URL=https://cashi.id
CASHI_PAYMENT_CHANNEL=QRIS_CUSTOM

# ==============================
# Payment mode
# ==============================
PAYMENT_MODE=both

# Optional limits
CASHI_MIN_AMOUNT=2000
CASHI_MAX_AMOUNT=10000000

# ==============================
# Manual/legacy settings if used by the existing handlers
# ==============================
MANUAL_QR_FILE_ID=
MANUAL_PAYMENT_NAME=QRIS Manual
CREATOR_UPGRADE_PRICE=150000

# Optional Redis
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Admin / channels used by existing project handlers
OWNER_ID=123456789
ADMIN_IDS=123456789
NOTIF_CHANNEL_ID=-1001234567890
UPDATE_CHANNEL_ID=-1001234567890
